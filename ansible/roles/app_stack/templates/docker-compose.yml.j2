# ---------------------------------------------------------------------------
# 由 Ansible 渲染（roles/app_stack）—— 手工修改会在下次运行 playbook 时被覆盖。
#
# 每台云服务器拿到的是**同一份模板**，但渲染结果里带着它自己的身份：
# 容器名、首页里的主机名与地址。这就是「批量配置」最直观的样子 ——
# 一份模板下发到 N 台机器，各显示各的。
#
# 刻意不写 `version:` 字段：compose v2 已经废弃它，写了会收到一条警告。
# ---------------------------------------------------------------------------
services:
  {{ wf_stack_name }}:
    image: {{ wf_stack_image }}
    container_name: {{ wf_stack_name }}
    restart: unless-stopped
    # ★ 只绑回环：公网入口是系统 nginx 的 80，它反代到这里。
    #   写成 "8080:80" 会绑到 0.0.0.0 —— 容器就又成了一个对外的第二入口，
    #   而安全组一旦放开这个端口，"只暴露 80"这句话立刻失效。
    ports:
      - "127.0.0.1:{{ wf_stack_port }}:80"
    volumes:
      # ★ 挂**目录**，不挂单个文件。
      #   单文件 bind mount 在 `docker compose up` 时就把宿主机那一份的 inode
      #   钉在容器里了：之后宿主机换了内容（哪怕文件路径没变），容器里读到的
      #   还是旧 inode，页面永远是上一版 —— 而且没有任何报错。
      #   挂目录则是按路径解析，换目录里的文件立刻生效，也不用重建容器。
      #   （发布/回滚正是靠这一点做到"不停容器换内容"。）
      - {{ wf_stack_public_dir }}:/usr/share/nginx/html:ro
    environment:
      WF_HOST: "{{ inventory_hostname }}"
      WF_ADDR: "{{ ansible_host | default('') }}"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
